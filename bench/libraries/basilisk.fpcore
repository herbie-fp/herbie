        [gamma2 (* (/ (* sgn J2) 2)
                   (pow (/ req a) 2))]
        [gamma2p
         (/ (* (/ (* sgn J2) 2)
               (pow (/ req a) 2))
            (pow (sqrt (- 1 (pow ecc 2))) 4))])
    (+ (clMeanOscMap-de1 ecc i omega sgn J2 req a)
       (* (/ (pow eta 2) 2)
