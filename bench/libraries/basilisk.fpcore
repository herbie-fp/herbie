                (+ (+ (+ (* ecc eta)
                         (/ ecc (+ 1 eta)))
                      (+ (* 3 (cos f))
                         (* (* 3 ecc) (pow (cos f) 2))))
                   (* (pow ecc 2) (pow (cos f) 3))))
