                (- (* ecc (sin (+ (* 2 omega) (* 3 f)))))))))))

(FPCore (i Omega di dOmega)
  :name "clMeanOscMap-d3"
  (+ (* (+ (sin (/ i 2))
           (* (/ (cos (/ i 2)) 2) di))
        (sin Omega))
     (* (* (sin (/ i 2))
           dOmega)
        (cos Omega))))

(FPCore (i Omega di dOmega)
  :name "d4"
  (- (* (+ (sin (/ i 2))
           (* (/ (cos (/ i 2)) 2) di))
        (cos Omega))
     (* (* (sin (/ i 2))
           dOmega)
        (sin Omega))))
