; -*- mode: scheme -*-

(FPCore (Ecc ecc)
  :name "E2f"
  :pre (and (>= ecc 0) (< ecc 1))
  (* 2
     (atan2
       (* (sqrt (+ 1 ecc)) (sin (/ Ecc 2)))
       (* (sqrt (- 1 ecc)) (cos (/ Ecc 2))))))

(FPCore (Ecc ecc)
  :name "E2M"
  :pre (and (>= ecc 0) (< ecc 1))
  (- Ecc (* ecc (sin Ecc))))

(FPCore (f ecc)
  :name "f2E"
  :pre (and (>= ecc 0) (< ecc 1))
  (* 2
     (atan2
       (* (sqrt (- 1 ecc)) (sin (/ f 2)))
       (* (sqrt (+ 1 ecc)) (cos (/ f 2))))))

(FPCore (f ecc)
  :name "f2H"
  :pre (> ecc 1)
  (* 2
     (atanh
       (* (sqrt (/ (- ecc 1) (+ ecc 1)))
          (tan (/ f 2))))))

(FPCore (H ecc)
  :name "H2f"
  :pre (> ecc 1)
  (* 2
     (atan
       (* (sqrt (/ (+ ecc 1) (- ecc 1)))
          (tanh (/ H 2))))))

(FPCore (H ecc)
  :name "H2N"
  :pre (> ecc 1)
  (- (* ecc (sinh H)) H))

(FPCore (M ecc)
  :name "M2E"
  :pre (and (>= ecc 0) (< ecc 1))
  (- M
     (/ (- (- M (* ecc (sin M))) M)
        (- 1 (* ecc (cos M))))))

(FPCore (N ecc)
  :name "N2H"
  :pre (> ecc 1)
  (- N
     (/ (- (- (* ecc (sinh N)) N) N)
        (- (* ecc (cosh N)) 1))))

(FPCore (a ecc)
  :name "semi_latus_rectum"
  (* a (- 1 (* ecc ecc))))

(FPCore (p ecc f)
  :name "orbit_radius"
  (/ p (+ 1 (* ecc (cos f)))))

(FPCore (mu p)
  :name "angular_momentum"
  (sqrt (* mu p)))

(FPCore (r AN theta i)
  :name "rVec_x"
  (* r
     (- (* (cos AN) (cos theta))
        (* (* (sin AN) (sin theta))
           (cos i)))))

(FPCore (r AN theta i)
  :name "rVec_y"
  (* r
     (+ (* (sin AN) (cos theta))
        (* (* (cos AN) (sin theta))
           (cos i)))))

(FPCore (r theta i)
  :name "rVec_z"
  (* r
     (* (sin theta) (sin i))))

(FPCore (mu h AN theta ecc AP i)
  :name "vVec_x"
  (* (- (/ mu h))
     (+ (* (cos AN) (+ (sin theta) (* ecc (sin AP))))
        (* (* (sin AN) (+ (cos theta) (* ecc (cos AP))))
           (cos i)))))

(FPCore (mu h AN theta ecc AP i)
  :name "vVec_y"
  (* (- (/ mu h))
     (- (* (sin AN) (+ (sin theta) (* ecc (sin AP))))
        (* (* (cos AN) (+ (cos theta) (* ecc (cos AP))))
           (cos i)))))

(FPCore (mu h theta ecc AP i)
  :name "vVec_z"
  (* (- (/ mu h))
     (* (- (+ (cos theta) (* ecc (cos AP))))
        (sin i))))

(FPCore (alt)
  :name "atmosphericDensity_poly"
  (pow 10
       (+ (+ (+ (+ (+ (+ (* 0.34047 (pow (/ (- alt 526.8000) 292.8563) 6))
                          (* (- 0.5889) (pow (/ (- alt 526.8000) 292.8563) 5)))
                       (* (- 0.5269) (pow (/ (- alt 526.8000) 292.8563) 4)))
                    (* 1.0036 (pow (/ (- alt 526.8000) 292.8563) 3)))
                 (* 0.60713 (pow (/ (- alt 526.8000) 292.8563) 2)))
              (* (- 2.3024) (/ (- alt 526.8000) 292.8563)))
          (- 12.575))))

(FPCore (density Cd A m v)
  :name "drag_accel_mag"
  :alt
  (! :herbie-platform c
   (let* ((n1 (/ density (exp2 (logb density))))
          (n2 (/ Cd (exp2 (logb Cd))))
          (n3 (/ A (exp2 (logb A))))
          (n4 (/ m (exp2 (logb m))))
          (n5 (/ v (exp2 (logb v))))
          (ex (- (+ (+ (logb density) (logb Cd)) (+ (logb A) (* 2 (logb v)))) (logb m)))
          (M (/ (* (* (* -500 n1) (* n2 n3)) (* n5 n5)) n4)))
     (if (< ex -1000)
         (* (* M (exp2 (+ ex 1074))) 4.9406564584124654e-324)
         (* M (exp2 ex)))))
  (/ (* (* (* (- 0.5) density)
           (/ (* Cd A) m))
        (pow (* v 1000) 2))
     1000))

(FPCore (a ecc i omega f sgn J2 req)
  :name "clMeanOscMap-ap"
  (let ([eta (sqrt (- 1 (pow ecc 2)))]
        [gamma2 (* (/ (* sgn J2) 2)
                   (pow (/ req a) 2))]
        [a_r (/ (+ 1 (* ecc (cos f)))
                (pow (sqrt (- 1 (pow ecc 2))) 2))])
    (+ a
       (* a
          (* gamma2
             (+ (* (- (* 3 (pow (cos i) 2)) 1)
                   (- (pow a_r 3)
                      (/ 1 (pow eta 3))))
                (* (* 3 (- 1 (pow (cos i) 2)))
                   (* (pow a_r 3)
                      (cos (+ (* 2 omega)
                              (* 2 f)))))))))))

(FPCore clMeanOscMap-de1 (ecc i omega sgn J2 req a)
  :alt
  (! :herbie-platform c
   (if (or (or (== ecc 0) (== i 0)) (or (or (== sgn 0) (== J2 0)) (== req 0)))
     0
     (let* ((e1 (logb ecc)) (e4 (logb sgn)) (e5 (logb J2)) (e6 (logb req)) (e7 (logb a))
            (sx (sin i)) (cx (cos i)) (es (logb sx))
            (n1 (/ ecc (exp2 e1))) (n4 (/ sgn (exp2 e4))) (n5 (/ J2 (exp2 e5)))
            (n6 (/ req (exp2 e6))) (n7 (/ a (exp2 e7))) (ns (/ sx (exp2 es)))
            (R (if (< (fabs cx) (fabs sx))
                   (/ (fma (* -15 cx) cx 1) (fma (* -5 cx) cx 1))
                   (/ (fma (* 15 sx) sx -14) (fma (* 5 sx) sx -4))))
            (C3 (if (< (fabs omega) 1e307)
                    (cos (* 2 omega))
                    (* (- (cos omega) (sin omega)) (+ (cos omega) (sin omega)))))
            (q (/ n6 n7))
            (M0 (* (* (* (* (* n1 n4) n5) (* q q)) (* ns ns)) (* R (* C3 0.0625))))
            (w (/ (* ecc ecc) (fma (- ecc) ecc 1)))
            (M (fma M0 w M0))
            (Ex (+ (+ (+ e1 e4) (+ e5 (* 2 e6))) (* 2 (- es e7))))
            (ka (floor (* Ex 0.5))))
       (* (* M (exp2 ka)) (exp2 (- Ex ka))))))
  (let ([eta (sqrt (- 1 (pow ecc 2)))]
        [gamma2p
         (/ (* (/ (* sgn J2) 2)
               (pow (/ req a) 2))
            (pow (sqrt (- 1 (pow ecc 2))) 4))])
    (* (* (* (/ gamma2p 8) ecc)
          (pow eta 2))
       (* (+ (- 1 (* 11 (pow (cos i) 2)))
             (- (/ (* 40 (pow (cos i) 4))
                   (- 1 (* 5 (pow (cos i) 2))))))
          (cos (* 2 omega))))))

