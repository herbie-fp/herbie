(FPCore (M omega Omega f ecc i sgn J2 req a)
  :name "clMeanOscMap-MpopOp"
  (let ([eta (sqrt (- 1 (pow ecc 2)))]
        [gamma2p
         (/ (* (/ (* sgn J2) 2)
