         (fma Ai t2 c)
         (let* ((h (if small (exp (* 0.5 (/ L betai))) (pow b (/ 0.5 betai)))))
           (+ (* (* Ai h) h) c)))))
  (let* ([delta_minus1 (- delta 1)]
         [pow_term (pow (* delta_minus1 delta_minus1) (/ 1 (* 2 betai)))])
    (+ (- 1 tau) (* Ai pow_term))))

