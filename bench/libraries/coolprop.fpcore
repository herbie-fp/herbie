                             (* (* (* d2u_dtau2 t1) tau) tau))
                         (* ti t1)))))
          (q (fma tau (* tau (* tau d3u_dtau3)) (+ ti ti)))
          (r0 (+ (pow t1 3) (+ B q)))
          (zh (* 0.5 (+ du_dtau (/ ti tau))))
          (Hs (fma zh (fma zh zh (* 0.75 d2u_dtau2)) (* 0.125 d3u_dtau3))))
