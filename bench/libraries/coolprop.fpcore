             (fma t t a)))))))
  (let* ([B_delta (+ (* delta du_ddelta) di)]
         [dB_delta_ddelta (+ (* delta d2u_ddelta2) du_ddelta)]
         [B_delta2 (+ (* delta dB_delta_ddelta) (* (- B_delta 1) B_delta))])
    B_delta2))

