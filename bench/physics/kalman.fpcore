;; From https://github.com/sandialabs/elaenia/blob/main/examples/05_kalman/05_gps/

(FPCore build_Q (dt)
  (array (array (* (* (* (* 0.25 dt) dt) dt) dt)
                (* (* (* 0.5 dt) dt) dt)
                (* (* 0.5 dt) dt))
         (array (* (* (* 0.5 dt) dt) dt)
                (* dt dt)
                dt)
         (array (* (* 0.5 dt) dt)
                dt
                1)))

(FPCore build_P ()
  (array (array 25  0 0)
         (array  0 10 0)
         (array  0  0 1)))

(FPCore build_F (dt)
  (array (array 1 dt (* (* 0.5 dt) dt))
         (array 0  1 dt)
         (array 0  0 1)))

(FPCore axb_33 ((a 3 3) (b 3 3))
  (array (array (+ (+ (* (ref (ref a 0) 0) (ref (ref b 0) 0))
                      (* (ref (ref a 0) 1) (ref (ref b 1) 0)))
                   (* (ref (ref a 0) 2) (ref (ref b 2) 0)))
                (+ (+ (* (ref (ref a 0) 0) (ref (ref b 0) 1))
                      (* (ref (ref a 0) 1) (ref (ref b 1) 1)))
                   (* (ref (ref a 0) 2) (ref (ref b 2) 1)))
                (+ (+ (* (ref (ref a 0) 0) (ref (ref b 0) 2))
                      (* (ref (ref a 0) 1) (ref (ref b 1) 2)))
                   (* (ref (ref a 0) 2) (ref (ref b 2) 2))))
         (array (+ (+ (* (ref (ref a 1) 0) (ref (ref b 0) 0))
                      (* (ref (ref a 1) 1) (ref (ref b 1) 0)))
                   (* (ref (ref a 1) 2) (ref (ref b 2) 0)))
                (+ (+ (* (ref (ref a 1) 0) (ref (ref b 0) 1))
                      (* (ref (ref a 1) 1) (ref (ref b 1) 1)))
                   (* (ref (ref a 1) 2) (ref (ref b 2) 1)))
                (+ (+ (* (ref (ref a 1) 0) (ref (ref b 0) 2))
                      (* (ref (ref a 1) 1) (ref (ref b 1) 2)))
                   (* (ref (ref a 1) 2) (ref (ref b 2) 2))))
         (array (+ (+ (* (ref (ref a 2) 0) (ref (ref b 0) 0))
                      (* (ref (ref a 2) 1) (ref (ref b 1) 0)))
                   (* (ref (ref a 2) 2) (ref (ref b 2) 0)))
                (+ (+ (* (ref (ref a 2) 0) (ref (ref b 0) 1))
                      (* (ref (ref a 2) 1) (ref (ref b 1) 1)))
                   (* (ref (ref a 2) 2) (ref (ref b 2) 1)))
                (+ (+ (* (ref (ref a 2) 0) (ref (ref b 0) 2))
                      (* (ref (ref a 2) 1) (ref (ref b 1) 2)))
                   (* (ref (ref a 2) 2) (ref (ref b 2) 2))))))

(FPCore axbT_33 ((a 3 3) (b 3 3))
  (array (array (+ (+ (* (ref (ref a 0) 0) (ref (ref b 0) 0))
                      (* (ref (ref a 0) 1) (ref (ref b 0) 1)))
                   (* (ref (ref a 0) 2) (ref (ref b 0) 2)))
                (+ (+ (* (ref (ref a 0) 0) (ref (ref b 1) 0))
                      (* (ref (ref a 0) 1) (ref (ref b 1) 1)))
                   (* (ref (ref a 0) 2) (ref (ref b 1) 2)))
                (+ (+ (* (ref (ref a 0) 0) (ref (ref b 2) 0))
                      (* (ref (ref a 0) 1) (ref (ref b 2) 1)))
                   (* (ref (ref a 0) 2) (ref (ref b 2) 2))))
         (array (+ (+ (* (ref (ref a 1) 0) (ref (ref b 0) 0))
                      (* (ref (ref a 1) 1) (ref (ref b 0) 1)))
                   (* (ref (ref a 1) 2) (ref (ref b 0) 2)))
                (+ (+ (* (ref (ref a 1) 0) (ref (ref b 1) 0))
                      (* (ref (ref a 1) 1) (ref (ref b 1) 1)))
                   (* (ref (ref a 1) 2) (ref (ref b 1) 2)))
                (+ (+ (* (ref (ref a 1) 0) (ref (ref b 2) 0))
                      (* (ref (ref a 1) 1) (ref (ref b 2) 1)))
                   (* (ref (ref a 1) 2) (ref (ref b 2) 2))))
         (array (+ (+ (* (ref (ref a 2) 0) (ref (ref b 0) 0))
                      (* (ref (ref a 2) 1) (ref (ref b 0) 1)))
                   (* (ref (ref a 2) 2) (ref (ref b 0) 2)))
                (+ (+ (* (ref (ref a 2) 0) (ref (ref b 1) 0))
                      (* (ref (ref a 2) 1) (ref (ref b 1) 1)))
                   (* (ref (ref a 2) 2) (ref (ref b 1) 2)))
                (+ (+ (* (ref (ref a 2) 0) (ref (ref b 2) 0))
                      (* (ref (ref a 2) 1) (ref (ref b 2) 1)))
                   (* (ref (ref a 2) 2) (ref (ref b 2) 2))))))

(FPCore a_add_b_33 ((a 3 3) (b 3 3))
  (array (array (+ (ref (ref a 0) 0) (ref (ref b 0) 0))
                (+ (ref (ref a 0) 1) (ref (ref b 0) 1))
                (+ (ref (ref a 0) 2) (ref (ref b 0) 2)))
         (array (+ (ref (ref a 1) 0) (ref (ref b 1) 0))
                (+ (ref (ref a 1) 1) (ref (ref b 1) 1))
                (+ (ref (ref a 1) 2) (ref (ref b 1) 2)))
         (array (+ (ref (ref a 2) 0) (ref (ref b 2) 0))
                (+ (ref (ref a 2) 1) (ref (ref b 2) 1))
                (+ (ref (ref a 2) 2) (ref (ref b 2) 2)))))

;; Keep these specs explicit so nested matrix-valued helpers do not expand
;; exponentially while Herbie loads the benchmark.
(FPCore predict_P ((P 3 3) (F 3 3) (Q 3 3))
   :spec (let* ([p00 (+ (+ (* (ref (ref P 0) 0) (ref (ref F 0) 0))
                              (* (ref (ref P 0) 1) (ref (ref F 0) 1)))
                           (* (ref (ref P 0) 2) (ref (ref F 0) 2)))]
                 [p01 (+ (+ (* (ref (ref P 0) 0) (ref (ref F 1) 0))
                              (* (ref (ref P 0) 1) (ref (ref F 1) 1)))
                           (* (ref (ref P 0) 2) (ref (ref F 1) 2)))]
                 [p02 (+ (+ (* (ref (ref P 0) 0) (ref (ref F 2) 0))
                              (* (ref (ref P 0) 1) (ref (ref F 2) 1)))
                           (* (ref (ref P 0) 2) (ref (ref F 2) 2)))]
                 [p10 (+ (+ (* (ref (ref P 1) 0) (ref (ref F 0) 0))
                              (* (ref (ref P 1) 1) (ref (ref F 0) 1)))
                           (* (ref (ref P 1) 2) (ref (ref F 0) 2)))]
                 [p11 (+ (+ (* (ref (ref P 1) 0) (ref (ref F 1) 0))
                              (* (ref (ref P 1) 1) (ref (ref F 1) 1)))
                           (* (ref (ref P 1) 2) (ref (ref F 1) 2)))]
                 [p12 (+ (+ (* (ref (ref P 1) 0) (ref (ref F 2) 0))
                              (* (ref (ref P 1) 1) (ref (ref F 2) 1)))
                           (* (ref (ref P 1) 2) (ref (ref F 2) 2)))]
                 [p20 (+ (+ (* (ref (ref P 2) 0) (ref (ref F 0) 0))
                              (* (ref (ref P 2) 1) (ref (ref F 0) 1)))
                           (* (ref (ref P 2) 2) (ref (ref F 0) 2)))]
                 [p21 (+ (+ (* (ref (ref P 2) 0) (ref (ref F 1) 0))
                              (* (ref (ref P 2) 1) (ref (ref F 1) 1)))
                           (* (ref (ref P 2) 2) (ref (ref F 1) 2)))]
                 [p22 (+ (+ (* (ref (ref P 2) 0) (ref (ref F 2) 0))
                              (* (ref (ref P 2) 1) (ref (ref F 2) 1)))
                           (* (ref (ref P 2) 2) (ref (ref F 2) 2)))])
           (array (array (+ (+ (* (ref (ref F 0) 0) p00)
                                (* (ref (ref F 0) 1) p10))
                             (+ (* (ref (ref F 0) 2) p20) (ref (ref Q 0) 0)))
                         (+ (+ (* (ref (ref F 0) 0) p01)
                                (* (ref (ref F 0) 1) p11))
                             (+ (* (ref (ref F 0) 2) p21) (ref (ref Q 0) 1)))
                         (+ (+ (* (ref (ref F 0) 0) p02)
                                (* (ref (ref F 0) 1) p12))
                             (+ (* (ref (ref F 0) 2) p22) (ref (ref Q 0) 2))))
                  (array (+ (+ (* (ref (ref F 1) 0) p00)
                                (* (ref (ref F 1) 1) p10))
                             (+ (* (ref (ref F 1) 2) p20) (ref (ref Q 1) 0)))
                         (+ (+ (* (ref (ref F 1) 0) p01)
                                (* (ref (ref F 1) 1) p11))
                             (+ (* (ref (ref F 1) 2) p21) (ref (ref Q 1) 1)))
                         (+ (+ (* (ref (ref F 1) 0) p02)
                                (* (ref (ref F 1) 1) p12))
                             (+ (* (ref (ref F 1) 2) p22) (ref (ref Q 1) 2))))
                  (array (+ (+ (* (ref (ref F 2) 0) p00)
                                (* (ref (ref F 2) 1) p10))
                             (+ (* (ref (ref F 2) 2) p20) (ref (ref Q 2) 0)))
                         (+ (+ (* (ref (ref F 2) 0) p01)
                                (* (ref (ref F 2) 1) p11))
                             (+ (* (ref (ref F 2) 2) p21) (ref (ref Q 2) 1)))
                         (+ (+ (* (ref (ref F 2) 0) p02)
                                (* (ref (ref F 2) 1) p12))
                             (+ (* (ref (ref F 2) 2) p22) (ref (ref Q 2) 2))))))
   (let* ([P (axbT_33 P F)]
          [P (axb_33 F P)]
          [P (a_add_b_33 P Q)])
     P))

(FPCore predict_x ((x 3) dt)
  (array (+ (+ (ref x 0) (ref x 1)) (* (* (* 0.5 dt) dt) (ref x 2)))
         (+ (ref x 1) (ref x 2))
         (ref x 2)))

(FPCore update_P ((P 3 3) (K 3))
  :spec (array (array (* (- 1 (ref K 0)) (ref (ref P 0) 0))
                     (* (- 1 (ref K 0)) (ref (ref P 0) 1))
                     (* (- 1 (ref K 0)) (ref (ref P 0) 2)))
               (array (+ (* (- (ref K 1)) (ref (ref P 0) 0))
                         (ref (ref P 1) 0))
                     (+ (* (- (ref K 1)) (ref (ref P 0) 1))
                         (ref (ref P 1) 1))
                     (+ (* (- (ref K 1)) (ref (ref P 0) 2))
                         (ref (ref P 1) 2)))
               (array (+ (* (- (ref K 2)) (ref (ref P 0) 0))
                         (ref (ref P 2) 0))
                     (+ (* (- (ref K 2)) (ref (ref P 0) 1))
                         (ref (ref P 2) 1))
                     (+ (* (- (ref K 2)) (ref (ref P 0) 2))
                         (ref (ref P 2) 2))))
  (let ([eyekh (array (array (- 1 (ref K 0)) 0 0)
                      (array (- (ref K 1)) 1 0)
                      (array (- (ref K 2)) 0 1))])
    (axb_33 eyekh P)))

(FPCore update_K ((P 3 3) r)
  (array (/ (ref (ref P 0) 0) (+ (ref (ref P 0) 0) r))
         (/ (ref (ref P 1) 0) (+ (ref (ref P 0) 0) r))
         (/ (ref (ref P 2) 0) (+ (ref (ref P 0) 0) r))))

(FPCore update_x ((x 3) (K 3) y)
  (array (+ (ref x 0) (* (ref K 0) y))
         (+ (ref x 1) (* (ref K 1) y))
         (+ (ref x 2) (* (ref K 2) y))))

(FPCore (m dt (x 3) (P 3 3))
  :name "Loop body, returning x"
  :spec (let* ([r00 (+ (+ (ref (ref P 0) 0)
                           (* dt (ref (ref P 0) 1)))
                        (* (* 0.5 dt) dt (ref (ref P 0) 2)))]
                 [r10 (+ (+ (ref (ref P 1) 0)
                           (* dt (ref (ref P 1) 1)))
                        (* (* 0.5 dt) dt (ref (ref P 1) 2)))]
                 [r20 (+ (+ (ref (ref P 2) 0)
                           (* dt (ref (ref P 2) 1)))
                        (* (* 0.5 dt) dt (ref (ref P 2) 2)))]
                 [p00 (+ (+ r00 (* dt r10))
                         (+ (* (* 0.5 dt) dt r20)
                            (* (* (* (* 0.25 dt) dt) dt) dt)))]
                 [p10 (+ r10 (* dt r20) (* (* 0.5 dt) dt dt))]
                 [p20 (+ r20 (* (* 0.5 dt) dt))]
                 [k0 (/ p00 (+ p00 16))]
                 [k1 (/ p10 (+ p00 16))]
                 [k2 (/ p20 (+ p00 16))]
                 [x0 (+ (+ (ref x 0) (ref x 1))
                         (* (* 0.5 dt) dt (ref x 2)))]
                 [x1 (+ (ref x 1) (ref x 2))]
                 [y (- m x0)])
           (array (+ x0 (* k0 y))
                  (+ x1 (* k1 y))
                  (+ (ref x 2) (* k2 y))))
  (let* ([F (build_F dt)]
         [Q (build_Q dt)]
         [r 16]
         [x (predict_x x dt)]
         [P (predict_P P F Q)]
         [y (- m (ref x 0))]
         [K (update_K P r)]
         [x (update_x x K y)]
         #;[P (update_P P K)])
    x))

(FPCore (#;m dt #;(x 3) (P 3 3))
  :name "Loop body, returning P"
  :spec (let* ([r00 (+ (+ (ref (ref P 0) 0)
                           (* dt (ref (ref P 0) 1)))
                        (* (* 0.5 dt) dt (ref (ref P 0) 2)))]
                 [r01 (+ (ref (ref P 0) 1) (* dt (ref (ref P 0) 2)))]
                 [r02 (ref (ref P 0) 2)]
                 [r10 (+ (+ (ref (ref P 1) 0)
                           (* dt (ref (ref P 1) 1)))
                        (* (* 0.5 dt) dt (ref (ref P 1) 2)))]
                 [r11 (+ (ref (ref P 1) 1) (* dt (ref (ref P 1) 2)))]
                 [r12 (ref (ref P 1) 2)]
                 [r20 (+ (+ (ref (ref P 2) 0)
                           (* dt (ref (ref P 2) 1)))
                        (* (* 0.5 dt) dt (ref (ref P 2) 2)))]
                 [r21 (+ (ref (ref P 2) 1) (* dt (ref (ref P 2) 2)))]
                 [r22 (ref (ref P 2) 2)]
                 [p00 (+ (+ r00 (* dt r10))
                         (+ (* (* 0.5 dt) dt r20)
                            (* (* (* (* 0.25 dt) dt) dt) dt)))]
                 [p01 (+ (+ r01 (* dt r11))
                         (+ (* (* 0.5 dt) dt r21)
                            (* (* (* 0.5 dt) dt) dt)))]
                 [p02 (+ (+ r02 (* dt r12))
                         (+ (* (* 0.5 dt) dt r22)
                            (* (* 0.5 dt) dt)))]
                 [p10 (+ r10 (* dt r20) (* (* 0.5 dt) dt dt))]
                 [p11 (+ r11 (* dt r21) (* dt dt))]
                 [p12 (+ r12 (* dt r22) dt)]
                 [p20 (+ r20 (* (* 0.5 dt) dt))]
                 [p21 (+ r21 dt)]
                 [p22 (+ r22 1)]
                 [k0 (/ p00 (+ p00 16))]
                 [k1 (/ p10 (+ p00 16))]
                 [k2 (/ p20 (+ p00 16))])
           (array (array (* (- 1 k0) p00)
                         (* (- 1 k0) p01)
                         (* (- 1 k0) p02))
                  (array (+ (* (- k1) p00) p10)
                         (+ (* (- k1) p01) p11)
                         (+ (* (- k1) p02) p12))
                  (array (+ (* (- k2) p00) p20)
                         (+ (* (- k2) p01) p21)
                         (+ (* (- k2) p02) p22))))
  (let* ([F (build_F dt)]
         [Q (build_Q dt)]
         [r 16]
         #;[x (predict_x x dt)]
         [P (predict_P P F Q)]
         #;[y (- m (ref x 0))]
         [K (update_K P r)]
         #;[x (update_x x K y)]
         [P (update_P P K)])
    P))
