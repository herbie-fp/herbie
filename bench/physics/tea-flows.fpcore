; -*- mode: scheme -*-

(FPCore (F l)
 :name "VandenBroeck and Keller, Equation (6)"
 (- (* PI l) (* (/ 1 (* F F)) (tan (* PI l)))))

(FPCore (f)
 :name "VandenBroeck and Keller, Equation (20)"
 :alt
 (! :herbie-platform c
  (if (< f 0.015625)
    (let* ((s (* f f))
           (g (* s (+ -0.26179938779914946 (* s (+ 0.037681239021197695 (* s (+ -0.006535638660399943 (* s 0.0012387141149697361)))))))))
      (fma 1.2732395447351628 (log f) (+ -0.3075694425175877 g)))
    (* -1.2732395447351628 (log1p (/ 2 (expm1 (* f 1.5707963267948966)))))))
 (let ((PI/4 (/ PI 4)))
   (let ((exp+ (exp (* PI/4 f))))
     (let ((exp- (exp (- (* PI/4 f)))))
       (- (* (/ 1 PI/4) (log (/ (+ exp+ exp-) (- exp+ exp-)))))))))

(FPCore (F B x)
 :name "VandenBroeck and Keller, Equation (23)"
 (+
  (- (* x (/ 1 (tan B))))
  (* (/ F (sin B)) (pow (+ (+ (* F F) 2) (* 2 x)) (- (/ 1 2))))))

(FPCore (B x)
 :name "VandenBroeck and Keller, Equation (24)"
 (+ (- (* x (/ 1 (tan B)))) (/ 1 (sin B))))
