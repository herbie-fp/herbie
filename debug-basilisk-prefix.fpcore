(FPCore (mu p)
  :name "angular_momentum"
  (sqrt (* mu p)))

(FPCore (alt)
  :name "atmosphericDensity_poly"
  (pow 10
       (+ (+ (+ (+ (+ (+ (* 0.34047 (pow (/ (- alt 526.8000) 292.8563) 6))
                          (* (- 0.5889) (pow (/ (- alt 526.8000) 292.8563) 5)))
                       (* (- 0.5269) (pow (/ (- alt 526.8000) 292.8563) 4)))
                    (* 1.0036 (pow (/ (- alt 526.8000) 292.8563) 3)))
                 (* 0.60713 (pow (/ (- alt 526.8000) 292.8563) 2)))
              (* (- 2.3024) (/ (- alt 526.8000) 292.8563)))
          (- 12.575))))

(FPCore (a e i omega f sgn J2 req)
  :name "clMeanOscMap-ap"
  (let ([eta (sqrt (- 1 (pow e 2)))]
        [gamma2 (* (/ (* sgn J2) 2)
                   (pow (/ req a) 2))]
        [a_r (/ (+ 1 (* e (cos f)))
                (pow (sqrt (- 1 (pow e 2))) 2))])
    (+ a
       (* a
          (* gamma2
             (+ (* (- (* 3 (pow (cos i) 2)) 1)
                   (- (pow a_r 3)
                      (/ 1 (pow eta 3))))
                (* (* 3 (- 1 (pow (cos i) 2)))
                   (* (pow a_r 3)
                      (cos (+ (* 2 omega) (* 2 f)))))))))))

(FPCore (i Omega di dOmega)
  :name "clMeanOscMap-d3"
  (+ (* (+ (sin (/ i 2))
           (* (/ (cos (/ i 2)) 2) di))
        (sin Omega))
     (* (* (sin (/ i 2)) dOmega)
        (cos Omega))))
