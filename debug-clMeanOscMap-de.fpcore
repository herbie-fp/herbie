       (* (+ (- 1 (* 11 (pow (cos i) 2)))
             (- (/ (* 40 (pow (cos i) 4))
                   (- 1 (* 5 (pow (cos i) 2))))))
          (cos (* 2 omega))))))

(FPCore (e i omega f sgn J2 req a)
