                    (pow (sqrt (- 1 (pow e 2))) 4))])
    (+ (clMeanOscMap-de1 e i omega sgn J2 req a)
       (* (/ (pow eta 2) 2)
          (- (* gamma2
                (+ (+ (+ (* e eta)
                         (/ e (+ 1 eta)))
                      (+ (* 3 (cos f))
                         (* (* 3 e) (pow (cos f) 2))))
                   (* (pow e 2) (pow (cos f) 3))))
             (* gamma2p
                (* (* (/ (* 3 (- 1 (pow (cos i) 2)))
                         (pow eta 6))
                      (+ (+ e
                            (+ (* 3 (cos f))
                               (* (* 3 e) (pow (cos f) 2))))
                         (* (pow e 2) (pow (cos f) 3))))
                   (cos (+ (* 2 omega) (* 2 f))))))))))
